# Copy this file to server/.env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/quickchat
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/test_quickchat
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
# Browser addresses allowed to call the API (comma-separated). Add your deployed client URL too.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: Cloudinary for image storage. Without these, images go to the uploads folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
